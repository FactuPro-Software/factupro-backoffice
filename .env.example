# ── Backoffice API (server-only — NEVER expose to the browser) ───────────────
# Base URL of the factupro-backend deployment exposing backoffice/api/v1.
# This varies per environment (dev/staging/prod) — do NOT default to localhost.
# Example (development): https://factupro-backend-development.up.railway.app
BACKOFFICE_API_BASE_URL=

# Single STATIC shared secret for the backoffice/api/v1 surface, sent on every
# request as the `x-api-key` header. Obtain the real value out-of-band from the
# backend team — see README for details. NEVER commit the real value here.
# MUST NOT be prefixed NEXT_PUBLIC_ (that would leak it into the client bundle).
API_KEY=
